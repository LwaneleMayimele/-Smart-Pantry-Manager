<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://android.com"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="3dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Ingredient Name -->
        <TextView
            android:id="@+id/text_ingredient_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Fresh Tomatoes"
            android:textColor="#212121"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/text_ingredient_qty"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toParentOf="parent"
            tools:ignore="MissingConstraints" />

        <!-- Expiry Date Indicator -->
        <TextView
            android:id="@+id/text_ingredient_expiry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Expires: 2026-10-05"
            android:textColor="#757575"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/text_ingredient_name" />

        <!-- Quantity Label -->
        <TextView
            android:id="@+id/text_ingredient_qty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5.0"
            android:textColor="#388E3C"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/text_ingredient_unit"
            app:layout_constraintTop_toParentOf="parent" />

        <!-- Unit Label -->
        <TextView
            android:id="@+id/text_ingredient_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="pcs"
            android:textColor="#388E3C"
            android:textSize="14sp"
            app:layout_constraintBaseline_toBaselineOf="@+id/text_ingredient_qty"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
